{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/:slug/embed",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors *;" }]
    },
    {
      "source": "/:slug/embed/:courtId",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors *;" }]
    }
  ]
}
