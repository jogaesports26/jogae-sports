generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  establishmentName    String?
  establishmentPhone   String?
  establishmentAddress String?

  courts               Court[]
  passwordResetTokens  PasswordResetToken[]
}

enum Role {
  PLAYER
  COURT_OWNER
}

model Court {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  sport       String
  surfaceType String
  hasLighting Boolean  @default(false)
  photoUrls   String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceRules        PriceRule[]
  reservations      Reservation[]
  maintenanceBlocks MaintenanceBlock[]
  reviews           Review[]

  @@index([ownerId])
}

model PriceRule {
  id           String   @id @default(uuid())
  courtId      String
  court        Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startMinute  Int
  endMinute    Int
  pricePerHour Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courtId, dayOfWeek])
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Reservation {
  id            String            @id @default(uuid())
  courtId       String
  court         Court             @relation(fields: [courtId], references: [id])
  playerId      String?
  player        Player?           @relation(fields: [playerId], references: [id])
  guestName     String?
  guestPhone    String?
  startsAt      DateTime
  endsAt        DateTime
  status        ReservationStatus @default(CONFIRMED)
  priceSnapshot Decimal           @db.Decimal(10, 2)
  cancelledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([courtId, startsAt, endsAt])
  @@index([playerId])

  review Review?
}

model Player {
  id              String    @id @default(uuid())
  phone           String    @unique
  name            String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reservations Reservation[]
  reviews      Review[]
}

model Review {
  id            String      @id @default(uuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  courtId       String
  court         Court       @relation(fields: [courtId], references: [id])
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([courtId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model MaintenanceBlock {
  id        String   @id @default(uuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([courtId, startsAt, endsAt])
}
