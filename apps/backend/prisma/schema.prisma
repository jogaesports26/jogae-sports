generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PLAYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  establishmentName    String?
  establishmentPhone   String?
  establishmentAddress String?
  establishmentSlug    String?  @unique
  monthlyRevenueGoal   Decimal? @db.Decimal(10, 2)
  aboutDescription     String?
  coverPhotoUrl        String?
  amenities            String[] @default([])

  courts              Court[]
  passwordResetTokens PasswordResetToken[]
  instructors         Instructor[]
  coupons             Coupon[]
  equipment           Equipment[]
  staffMembers        StaffMember[]
}

enum Role {
  PLAYER
  COURT_OWNER
}

model Court {
  id                String   @id @default(uuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  name              String
  sport             String
  surfaceType       String
  hasLighting       Boolean  @default(false)
  photoUrls         String[]
  active            Boolean  @default(true)
  minBookingMinutes Int      @default(60)
  slotStepMinutes   Int      @default(60)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  priceRules                 PriceRule[]
  reservations               Reservation[]
  maintenanceBlocks          MaintenanceBlock[]
  recurringMaintenanceBlocks RecurringMaintenanceBlock[]
  reviews                    Review[]
  waitlist                   Waitlist[]

  @@index([ownerId])
}

model PriceRule {
  id           String   @id @default(uuid())
  courtId      String
  court        Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startMinute  Int
  endMinute    Int
  pricePerHour Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courtId, dayOfWeek])
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Reservation {
  id             String            @id @default(uuid())
  courtId        String
  court          Court             @relation(fields: [courtId], references: [id])
  playerId       String?
  player         Player?           @relation(fields: [playerId], references: [id])
  guestName      String?
  guestPhone     String?
  startsAt       DateTime
  endsAt         DateTime
  status         ReservationStatus @default(CONFIRMED)
  priceSnapshot  Decimal           @db.Decimal(10, 2)
  cancelledAt    DateTime?
  reminderSentAt DateTime?
  instructorId   String?
  instructor     Instructor?       @relation(fields: [instructorId], references: [id])
  couponId       String?
  coupon         Coupon?           @relation(fields: [couponId], references: [id])
  discountAmount Decimal?          @db.Decimal(10, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  review         Review?
  equipmentItems ReservationEquipment[]

  @@index([courtId, startsAt, endsAt])
  @@index([playerId])
  @@index([couponId])
  @@index([instructorId])
}

model Waitlist {
  id         String    @id @default(uuid())
  courtId    String
  court      Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  startsAt   DateTime
  endsAt     DateTime
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([courtId, startsAt, endsAt])
}

model Player {
  id              String    @id @default(uuid())
  phone           String    @unique
  name            String?
  birthDate       DateTime? @db.Date
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reservations Reservation[]
  reviews      Review[]
}

model Review {
  id            String      @id @default(uuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  courtId       String
  court         Court       @relation(fields: [courtId], references: [id])
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id])
  rating        Int
  comment       String?
  ownerReply     String?
  ownerRepliedAt DateTime?
  createdAt     DateTime    @default(now())

  @@index([courtId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model MaintenanceBlock {
  id          String    @id @default(uuid())
  courtId     String
  court       Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  cost        Decimal?  @db.Decimal(10, 2)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([courtId, startsAt, endsAt])
}

model RecurringMaintenanceBlock {
  id          String   @id @default(uuid())
  courtId     String
  court       Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  reason      String?
  createdAt   DateTime @default(now())

  @@index([courtId, dayOfWeek])
}

model Instructor {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  reservations Reservation[]

  @@index([ownerId])
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id            String             @id @default(uuid())
  ownerId       String
  owner         User               @relation(fields: [ownerId], references: [id])
  code          String
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  validFrom     DateTime?
  validUntil    DateTime?
  usageLimit    Int?
  usageCount    Int                @default(0)
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())

  reservations Reservation[]

  @@unique([ownerId, code])
  @@index([ownerId])
}

model Equipment {
  id           String   @id @default(uuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])
  name         String
  pricePerUnit Decimal  @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  reservationItems ReservationEquipment[]

  @@index([ownerId])
}

model ReservationEquipment {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  equipmentId   String
  equipment     Equipment   @relation(fields: [equipmentId], references: [id])
  name          String
  unitPrice     Decimal     @db.Decimal(10, 2)
  quantity      Int
  createdAt     DateTime    @default(now())

  @@index([reservationId])
  @@index([equipmentId])
}

enum StaffPermission {
  MANAGE_RESERVATIONS
  VIEW_ONLY
}

model StaffMember {
  id         String          @id @default(uuid())
  ownerId    String
  owner      User            @relation(fields: [ownerId], references: [id])
  name       String
  email      String          @unique
  password   String
  permission StaffPermission @default(MANAGE_RESERVATIONS)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([ownerId])
}
