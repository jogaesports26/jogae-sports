# Copie este arquivo para apps/backend/.env (ele é ignorado pelo git) e troque os valores.
# Desenvolvimento local: suba o Postgres com `docker compose -f docker-compose.dev.yml --env-file apps/backend/.env up -d`
# (na raiz do repositório). A senha abaixo precisa ser a MESMA em POSTGRES_PASSWORD, DATABASE_URL e DIRECT_URL.
POSTGRES_PASSWORD="troque-por-uma-senha-local"
DATABASE_URL="postgresql://jogae:troque-por-uma-senha-local@127.0.0.1:5432/jogae?schema=public"
DIRECT_URL="postgresql://jogae:troque-por-uma-senha-local@127.0.0.1:5432/jogae?schema=public"
PORT=3000
# JWT_SECRET: obrigatório; use 32 caracteres ou mais (openssl rand -hex 32).
JWT_SECRET="troque-por-um-segredo-forte-com-32-caracteres-ou-mais"
# CORS_ORIGINS: opcional, origens separadas por vírgula. Sem ela só o localhost de desenvolvimento é aceito.
# CORS_ORIGINS="http://localhost:5173"
# OTP_EXPOSE_DEV_CODE: "true" devolve o código OTP na resposta (único jeito de logar como jogador sem provedor de
# SMS/WhatsApp). SÓ em desenvolvimento ou demonstração com dados fictícios; em produção, desligada.
OTP_EXPOSE_DEV_CODE="true"
# Senhas das contas criadas pelo seed (opcional; sem elas o seed gera senhas aleatórias e mostra uma vez).
# SEED_OWNER_PASSWORD=""
# SEED_STAFF_PASSWORD=""
# ANTHROPIC_API_KEY: opcional - habilita o chatbot de IA generativa do Portal do Cliente
ANTHROPIC_API_KEY=""
