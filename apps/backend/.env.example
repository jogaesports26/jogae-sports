# Copie este arquivo para .env e preencha com suas credenciais reais
# DATABASE_URL: Supabase pooler transaction (porta 6543) - usado em runtime pela app
DATABASE_URL="postgresql://usuario:senha@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Supabase pooler session (porta 5432) - usado pelo Prisma Migrate
DIRECT_URL="postgresql://usuario:senha@aws-0-region.pooler.supabase.com:5432/postgres"
PORT=3000
JWT_SECRET="troque-por-um-segredo-forte"
